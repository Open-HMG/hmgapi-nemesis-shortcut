{
  "id": "nemesis-shortcut",
  "name": "NEMESIS in the app menu",
  "version": "1.1.0",
  "hmgapi": ">=0.1.0",
  "authors": [
    "VysseCodes"
  ],
  "license": "AGPL-3.0",
  "description": "Adds NEMESIS Manager to the all-apps menu, and offers it as a star key action.",
  "provides": {
    "launcher": [
      {
        "id": "nemesis",
        "package": "com.nemesis.manager",
        "class": ".MainActivity"
      }
    ],
    "star_key": [
      {
        "id": "open",
        "title": "Open NEMESIS",
        "activity": {
          "package": "com.nemesis.manager",
          "class": ".MainActivity"
        }
      }
    ]
  }
}
